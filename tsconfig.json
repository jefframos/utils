{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowJs": true,
        "checkJs": false,
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "scripts/**/*.js",
        "vite.config.ts"
    ],
    "exclude": [
        "apps/**",
        "node_modules"
    ]
}